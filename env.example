# Скопируйте в .env и заполните нужное. Файл .env в git не попадает.
# Ничего не заполнено: сервис сам найдёт вошедшие подписки Claude Code и Codex, а в интерфейсе останется режим demo.

# Ключи API: хватит одного. Самая слабая модель выбирается автоматически.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Любой OpenAI-совместимый API (OpenRouter, Groq, LM Studio, Ollama). Для локальной модели ключ не нужен.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Выбор вручную: auto, claude-cli, codex-cli, gemini-cli, anthropic, openai, google, compatible, demo
LLM_PROVIDER=auto

# Необязательно. Вордстат через Yandex Cloud Search API: частотность поисковых запросов.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
# Необязательно. Яндекс Метрика: реальные запросы страницы, нужно поле url во входных данных.
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER=
